rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS FOR UNTRUSTED-CLIENT SECURITY MODEL
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isAccountOwner(accountId) {
      return isAuthenticated() && request.auth.uid == accountId;
    }

    // Authoritative Server Version Progression: client cannot invent versions
    function isValidVersionIncrement() {
      return !('version' in resource.data) || 
             (request.resource.data.version == resource.data.version + 1);
    }

    // Field-level immutability enforcement
    function isImmutable(fieldName) {
      return !(fieldName in request.resource.data) || 
             request.resource.data[fieldName] == resource.data[fieldName];
    }

    function isParticipant(participantsList) {
      return isAuthenticated() && request.auth.uid in participantsList;
    }

    // =========================================================================
    // 1. ACCOUNT & MANAGED PERSONS (Account UID != Person ID)
    // =========================================================================
    match /accounts/{accountId} {
      function validFileKeyFingerprint() {
        return !('fileKeyFingerprintV2' in request.resource.data) ||
          (request.resource.data.fileKeyFingerprintV2 is string &&
            request.resource.data.fileKeyFingerprintV2.matches('^[0-9a-f]{64}$'));
      }
      function preservesFileKeyFingerprint() {
        return !('fileKeyFingerprintV2' in resource.data) ||
          ('fileKeyFingerprintV2' in request.resource.data &&
            request.resource.data.fileKeyFingerprintV2 == resource.data.fileKeyFingerprintV2);
      }
      // Account identity and an established file-key fingerprint survive every update.
      allow read: if isAccountOwner(accountId);
      allow create: if isAccountOwner(accountId) &&
                       request.resource.data.accountUid == accountId &&
                       validFileKeyFingerprint();
      allow update: if isAccountOwner(accountId) &&
                       isImmutable('accountUid') &&
                       isImmutable('createdAt') &&
                       validFileKeyFingerprint() && preservesFileKeyFingerprint();
      allow delete: if false; // Accounts must be closed via backend deletion pipeline

      // Managed People (Me, Child, Elderly Dependents)
      match /people/{personId} {
        allow read, write: if isAccountOwner(accountId);
      }

      // Contact Methods (Phones, Emails)
      match /contacts/{contactId} {
        allow read, write: if isAccountOwner(accountId);
      }

      // Addresses (Temporally versioned)
      match /addresses/{addressId} {
        allow read, write: if isAccountOwner(accountId);
      }

      // Education & Career Records
      match /education/{eduId} {
        allow read, write: if isAccountOwner(accountId);
      }
      match /employment/{workId} {
        allow read, write: if isAccountOwner(accountId);
      }

      // Health Dossier: Stored exclusively as ciphertext blobs (Zone 3 Zero-Knowledge)
      match /healthRecords/{recordId} {
        allow read, write: if isAccountOwner(accountId);
      }

      // Document metadata upgrades keep encrypted fields protected against stale writers.
      match /documents/{docId} {
        function protectedHeader() {
          return request.resource.data.metadataFormatVersion == 2 &&
            request.resource.data.metadataCiphertext is string && request.resource.data.metadataIv is string &&
            !request.resource.data.keys().hasAny(['documentType', 'title', 'documentNumber', 'issuingAuthority',
              'issuingCountry', 'issueDate', 'expirationDate', 'securityClassification', 'isLocked', 'notes', 'createdAt']);
        }
        function compactDeletion() {
          return ('isDeleted' in request.resource.data) && request.resource.data.isDeleted == true &&
            request.resource.data.keys().hasOnly(['documentId', 'personId', 'isDeleted', 'updatedAt']);
        }
        allow read: if isAccountOwner(accountId);
        allow create: if isAccountOwner(accountId) &&
          (!('metadataFormatVersion' in request.resource.data) || protectedHeader());
        allow update: if isAccountOwner(accountId) &&
          (!(('isDeleted' in resource.data) && resource.data.isDeleted == true) || compactDeletion()) &&
          (compactDeletion() || !('metadataFormatVersion' in resource.data) || protectedHeader());
        allow delete: if isAccountOwner(accountId) &&
          !(('isDeleted' in resource.data) && resource.data.isDeleted == true);

        match /versions/{versionId} {
          function protectedVersion() {
            return request.resource.data.metadataFormatVersion == 2 &&
              request.resource.data.metadataCiphertext is string && request.resource.data.metadataIv is string &&
              !request.resource.data.keys().hasAny(['notes', 'originalFilename', 'createdAt']);
          }
          function activeParent() {
            return exists(/databases/$(database)/documents/accounts/$(accountId)/documents/$(docId)) &&
              !(('isDeleted' in get(/databases/$(database)/documents/accounts/$(accountId)/documents/$(docId)).data) &&
                get(/databases/$(database)/documents/accounts/$(accountId)/documents/$(docId)).data.isDeleted == true);
          }
          allow read, delete: if isAccountOwner(accountId);
          allow create: if isAccountOwner(accountId) && activeParent() &&
            (!('metadataFormatVersion' in request.resource.data) || protectedVersion());
          allow update: if isAccountOwner(accountId) && activeParent() &&
            (!('metadataFormatVersion' in resource.data) || protectedVersion());
        }
      }

      // Passphrase-protected portable file keys remain private to the account owner.
      match /vaultEscrow/{escrowId} {
        function hasPassphraseRecovery() {
          let latest = get(/databases/$(database)/documents/accounts/$(accountId)/vaultEscrow/latest).data;
          let recovery = get(/databases/$(database)/documents/accounts/$(accountId)/vaultEscrow/$(latest.keyId)).data;
          return latest.isCiphertext == true && latest.keyId is string &&
            latest.keyId != 'latest' && latest.keyId != 'account_sync_pfk' &&
            recovery.isCiphertext == true &&
            recovery.saltBase64 is string && recovery.saltBase64.size() > 0 &&
            recovery.wrappedKeyBase64 is string && recovery.wrappedKeyBase64.size() > 0 &&
            recovery.wrapIvBase64 is string && recovery.wrapIvBase64.size() > 0 &&
            recovery.kdfAlgorithm == 'PBKDF2WithHmacSHA256' &&
            recovery.iterations is int && recovery.iterations >= 100000;
        }
        allow read: if isAccountOwner(accountId);
        allow create, update: if isAccountOwner(accountId) && escrowId != 'account_sync_pfk' &&
          request.resource.data.isCiphertext == true;
        // Retire the former public-UID wrap only after passphrase recovery is durable.
        allow delete: if isAccountOwner(accountId) && escrowId == 'account_sync_pfk' &&
          hasPassphraseRecovery();
      }

      // Profile photos (avatar / contact / ID): encrypted B2 blobs, metadata only.
      // Same owner-only access as documents; never plaintext.
      match /photos/{photoId} {
        allow read, write: if isAccountOwner(accountId);
      }
      match /photo_tombstones/{tombstoneId} {
        allow read, write: if isAccountOwner(accountId);
      }

      // Encrypted wallpaper metadata and deletion markers follow photo ownership.
      match /wallpapers/{wallpaperId} {
        allow read, write: if isAccountOwner(accountId);
      }
      match /wallpaper_tombstones/{tombstoneId} {
        allow read, write: if isAccountOwner(accountId);
      }

      // App-owned encrypted originals. Chunks are immutable after publication.
      match /media/{blobId} {
        allow read: if isAccountOwner(accountId);
        allow create: if isAccountOwner(accountId) && request.resource.data.ownerUid == accountId;
        allow update: if isAccountOwner(accountId) && resource.data.ownerUid == accountId &&
          request.resource.data.ownerUid == accountId && request.resource.data.isDeleted == true;
        allow delete: if false;
        match /chunks/{chunkId} {
          allow read: if isAccountOwner(accountId) &&
            exists(/databases/$(database)/documents/accounts/$(accountId)/media/$(blobId)) &&
            get(/databases/$(database)/documents/accounts/$(accountId)/media/$(blobId)).data.isDeleted == false;
          allow create, update: if isAccountOwner(accountId) &&
            !exists(/databases/$(database)/documents/accounts/$(accountId)/media/$(blobId)) &&
            request.resource.data.keys().hasOnly(['data']) &&
            request.resource.data.data is bytes && request.resource.data.data.size() <= 524288;
          allow delete: if isAccountOwner(accountId) &&
            exists(/databases/$(database)/documents/accounts/$(accountId)/media/$(blobId)) &&
            get(/databases/$(database)/documents/accounts/$(accountId)/media/$(blobId)).data.isDeleted == true;
        }
      }

      // Active Devices & Sessions
      match /sessions/{sessionId} {
        allow read, write: if isAccountOwner(accountId);
      }

      // Local Tombstones for Offline Sync Horizon
      match /tombstones/{tombstoneId} {
        allow read: if isAccountOwner(accountId);
        allow create: if isAccountOwner(accountId) &&
                         request.resource.data.timestamp <= request.time;
        allow update, delete: if false;
      }

      // Plain Notes & Rich Journal
      match /notes/{noteId} {
        allow read, write: if isAccountOwner(accountId);

        match /attachments/{attachmentId} {
          allow read, write: if isAccountOwner(accountId);
        }
      }

      // Fortress Vault (Credentials, Logins, Secure Items)
      match /vault/{itemId} {
        allow read: if isAccountOwner(accountId);
        allow create: if isAccountOwner(accountId);
        allow update: if isAccountOwner(accountId) &&
          (!(('isDeleted' in resource.data) && resource.data.isDeleted == true) ||
            (request.resource.data.isDeleted == true &&
             request.resource.data.keys().hasOnly(['id', 'personId', 'isDeleted', 'updatedAt'])));
        allow delete: if isAccountOwner(accountId) &&
          !(('isDeleted' in resource.data) && resource.data.isDeleted == true);
        match /proofs/{proofId} {
          allow read, write: if isAccountOwner(accountId);
          match /chunks/{chunkId} {
            allow read, write: if isAccountOwner(accountId);
          }
        }
      }

      // Social & Online Accounts
      match /socialAccounts/{socialId} {
        allow read, write: if isAccountOwner(accountId);
      }

      // Kinship & Relationships
      match /relationships/{relId} {
        allow read, write: if isAccountOwner(accountId);
      }
      match /relationshipNotes/{relNoteId} {
        allow read, write: if isAccountOwner(accountId);
        match /attachments/{attachmentId} {
          allow read, write: if isAccountOwner(accountId);
        }
      }
    }

    // =========================================================================
    // 2. RELATIONSHIPS & KINSHIP GRAPH (Relationship != Permission)
    // =========================================================================
    match /relationships/{relId} {
      // Readable strictly by the two participants
      allow read: if isParticipant(resource.data.participants);

      // Create: Creator must be authenticated and listed as participant
      allow create: if isAuthenticated() && 
                    request.resource.data.createdBy == request.auth.uid &&
                    request.auth.uid in request.resource.data.participants;

      // Update: Participants can update state (e.g. ACCEPT/DECLINE), but cannot alter ownership
      allow update: if isParticipant(resource.data.participants) && 
                       isImmutable('createdBy') && 
                       isImmutable('participants');

      // Delete: Either participant can disconnect
      allow delete: if isParticipant(resource.data.participants);
    }

    // =========================================================================
    // 3. SHARING PROFILES & CAPABILITY TOKENS
    // =========================================================================
    match /sharingProfiles/{shareId} {
      // Sovereign owner has full control
      allow read: if isAuthenticated() && 
                     (resource == null || resource.data.ownerAccountId == request.auth.uid);

      allow create: if isAuthenticated() && 
                       request.resource.data.ownerAccountId == request.auth.uid &&
                       request.resource.data.shareId == shareId;

      allow update: if isAuthenticated() && 
                       resource.data.ownerAccountId == request.auth.uid && 
                       isImmutable('shareId') && 
                       isImmutable('ownerAccountId') && 
                       isImmutable('tokenHash');

      allow delete: if isAuthenticated() && 
                       resource.data.ownerAccountId == request.auth.uid;

      // NOTE: External recipients DO NOT directly read or query sharingProfiles in Firestore.
      // Capability resolution is executed exclusively via trusted serverless Cloud Function 'resolveShareToken'.
    }

    // =========================================================================
    // 4. AUDIT TRAIL (Cryptographically Chained & Tamper-Evident)
    // =========================================================================
    match /auditEvents/{eventId} {
      // Authenticated users can read their own audit trail
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Append-only: User appends next chained event; past events are strictly immutable
      allow create: if isAuthenticated() && 
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.eventId == eventId &&
                    request.resource.data.timestamp <= request.time;

      allow update, delete: if false; // Tamper detection: no event can ever be modified or purged
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
