# Persona Vault — Enterprise Secrets Configuration Template
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
# Copy this file to 'secrets.properties' (which is excluded by .gitignore) for local configuration.
# For CI/CD (GitHub Actions), populate these via GitHub Secrets / Environment Variables.

# Keystore Signing Configuration (Production Release Builds)
RELEASE_KEYSTORE_PATH=
RELEASE_KEYSTORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=

# Firebase / Remote Sync Gateway Overrides (Optional)
FIREBASE_PROJECT_ID=
FIREBASE_APPLICATION_ID=
FIREBASE_API_KEY=

# Backblaze B2 (REQUIRED for cloud binary backup — never commit real values)
# 1. Rotate the previously hardcoded key in the B2 console (treat as compromised).
# 2. Copy this file to 'secrets.properties' and fill in the NEW values.
# 3. CI: populate the same keys via GitHub Secrets / Environment Variables.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=
